:root {
    --page-width: 210mm;
    --page-height: 297mm;
    --page-margin: 1.5cm;
}

@page {
    size: A4;
    margin: var(--page-margin);
}

*,
*::before,
*::after {
    box-sizing: border-box;
}

body {
    margin: 0;
    font-family: Inter, sans-serif;
    font-size: 10.5pt;
    line-height: 1.35;
    color: #111;
}

h1,
h2,
h3,
h4 {
    margin: 0 0 0.25em;
    line-height: 1.2;
}

h1 {
    font-size: 18pt;
}

h2 {
    font-size: 12pt;
    margin-top: 0.75em;
    margin-bottom: 0.35em;
    break-after: avoid;
    page-break-after: avoid;
}

h3 {
    font-size: 11pt;
    break-after: avoid;
    page-break-after: avoid;
}

h4 {
    font-size: 10.5pt;
    break-after: avoid;
    page-break-after: avoid;
}

p,
ul,
dl {
    margin: 0 0 0.35em;
}

ul {
    padding-left: 1.1em;
}

li {
    margin-bottom: 0.15em;
}

ul.skills,
ul.languages {
    display: flex;
    flex-wrap: wrap;
    gap: 0.15em 0.5em;
    list-style: none;
    padding-left: 0;
}

ul.skills li,
ul.languages li {
    margin: 0;
}

ul.skills li:not(:last-child)::after,
ul.languages li:not(:last-child)::after {
    content: "·";
    margin-left: 0.5em;
}

ul.skill-groups {
    list-style: none;
    padding-left: 0;
    margin: 0 0 0.35em;
}

ul.skill-groups > li {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    column-gap: 0.45em;
    row-gap: 0.1em;
    margin-bottom: 0.12em;
}

.skill-group-label {
    font-weight: 600;
    flex: 0 0 auto;
}

.skill-group-label::after {
    content: ":";
}

ul.skill-groups .skills {
    margin: 0;
}

address {
    font-style: normal;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    column-gap: 0.35em;
    row-gap: 0.15em;
}

address [role="separator"] {
    color: #666;
}

a {
    color: inherit;
}

hr.cv-anchor {
    border: none;
    border-top: 2.5pt solid #111;
    margin: 0.55em 0 0.7em;
    width: 100%;
}

.cv-body {
    padding-left: 1.2em;
    text-align: justify;
    hyphens: auto;
}

.cv-body h2,
.cv-body h3,
.cv-body h4 {
    text-align: left;
    hyphens: none;
}

/* Article headers: h3/h4 inline, dates/tenure flush right, meta muted */
article > header {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    column-gap: 0.5em;
    row-gap: 0.1em;
    margin-bottom: 0.35em;
}

article > header h3,
article > header h4 {
    display: inline;
    margin: 0;
}

article > header h4 {
    font-weight: 700;
}

/* Nested role entries under an employer */
article article {
    margin-top: 0.35em;
}

article article:first-of-type {
    margin-top: 0.15em;
}

article > header > time:first-of-type,
article > header > .tenure {
    margin-left: auto;
}

article > header > .meta {
    font-size: 0.9em;
    color: #444;
}

article > header [role="separator"] {
    margin: 0;
}

/* Keep job/education/certificate blocks intact across page breaks */
section > article,
article article,
ul.skill-groups > li {
    break-inside: avoid;
    page-break-inside: avoid;
}

/* Page 2: education and certificates after experience */
.cv-secondary {
    break-before: page;
    page-break-before: always;
}

.cv-secondary > section:first-child > h2 {
    margin-top: 0;
}

main {
    width: var(--page-width);
    min-height: var(--page-height);
    height: auto;
    padding: var(--page-margin);
    overflow: visible;
    background: #fff;
}

main > footer {
    display: none;
}

@media screen {
    body {
        min-height: 100vh;
        padding: 1.5rem;
        background: #d4d4d4;
    }

    main {
        margin: 0 auto;
        box-shadow: 0 0 0 1px #bbb;
    }

    /* Screen preview: show the page-2 boundary without forcing a blank gap */
    .cv-secondary {
        break-before: auto;
        page-break-before: auto;
        margin-top: 1.25em;
        padding-top: 1em;
        border-top: 0.5pt solid #bbb;
    }
}

@media print {
    html,
    body {
        margin: 0;
        padding: 0;
        background: none;
    }

    main {
        width: auto;
        min-height: 0;
        margin: 0;
        padding: 0;
        box-shadow: none;
    }

    main > footer {
        display: none;
    }

    .cv-secondary {
        border-top: none;
        margin-top: 0;
        padding-top: 0;
    }
}
