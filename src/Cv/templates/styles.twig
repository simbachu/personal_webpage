:root {
    --page-width: 210mm;
    --page-height: 297mm;
    --page-margin: 1.5cm;
}

@page {
    size: A4;
    margin: var(--page-margin);
}

* {
    box-sizing: border-box;

    &::before,
    &::after {
        box-sizing: border-box;
    }
}

body {
    margin: 0;
    font-family: Inter, sans-serif;
    font-size: 10.5pt;
    line-height: 1.35;
    color: #111;

    @media screen {
        min-height: 100vh;
        padding: 1.5rem;
        background: #d4d4d4;
    }

    @media print {
        margin: 0;
        padding: 0;
        background: none;
    }
}

h1,
h2,
h3,
h4 {
    margin: 0 0 0.25em;
    line-height: 1.2;
}

h1 {
    font-size: 18pt;
}

h2 {
    font-size: 12pt;
    margin-top: 0.75em;
    margin-bottom: 0.35em;
    break-after: avoid;
    page-break-after: avoid;
}

h3 {
    font-size: 11pt;
    break-after: avoid;
    page-break-after: avoid;
}

h4 {
    font-size: 10.5pt;
    break-after: avoid;
    page-break-after: avoid;
}

p,
ul,
dl {
    margin: 0 0 0.35em;
}

ul {
    padding-left: 1.1em;

    &.skills,
    &.languages {
        display: flex;
        flex-wrap: wrap;
        gap: 0.15em 0.5em;
        list-style: none;
        padding-left: 0;

        & li {
            margin: 0;

            &:not(:last-child)::after {
                content: "·";
                margin-left: 0.5em;
            }
        }
    }

    &.skill-groups {
        list-style: none;
        padding-left: 0;
        margin: 0 0 0.35em;

        & > li {
            display: flex;
            flex-wrap: wrap;
            align-items: baseline;
            column-gap: 0.45em;
            row-gap: 0.1em;
            margin-bottom: 0.12em;
            break-inside: avoid;
            page-break-inside: avoid;
        }

        & .skills {
            margin: 0;
        }
    }
}

li {
    margin-bottom: 0.15em;
}

.skill-group-label {
    font-weight: 600;
    flex: 0 0 auto;

    &::after {
        content: ":";
    }
}

address {
    font-style: normal;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    column-gap: 0.35em;
    row-gap: 0.15em;

    & [role="separator"] {
        color: #666;
    }
}

a {
    color: inherit;
}

hr.cv-anchor {
    border: none;
    border-top: 0.8pt solid #111;
    margin: 0.55em 0 0.7em;
    width: 100%;
}

.cv-body {
    padding-left: 15mm;
    text-align: left;
    hyphens: none;

    & h2,
    & h3,
    & h4 {
        text-align: left;
        hyphens: none;
    }
}

/* Article headers: h3/h4 inline, dates/tenure flush right, meta muted */
article {
    & > header {
        display: flex;
        flex-wrap: wrap;
        align-items: baseline;
        column-gap: 0.5em;
        row-gap: 0.1em;
        margin-bottom: 0.35em;

        & h3,
        & h4 {
            display: inline;
            margin: 0;
        }

        & h4 {
            font-weight: 600;
        }

        & > time:first-of-type,
        & > .tenure {
            margin-left: auto;
        }

        & > .meta {
            font-size: 0.9em;
            color: #444;
        }

        & [role="separator"] {
            margin: 0;
        }
    }

    & :has(h3) {
        margin-bottom: 2rem;
    }

    /* Nested role entries under an employer */
    & article {
        margin-top: 0.65em;
        break-inside: avoid;
        page-break-inside: avoid;

        &:first-of-type {
            margin-top: 0.25em;
        }

        & > p + ul {
            margin-top: 0.3em;
        }

        & li {
            margin-bottom: 0.3em;
        }
    }

    & time,
    & .tenure {
        white-space: nowrap;
        font-variant-numeric: tabular-nums;
    }
}

/* Keep job/education/certificate blocks intact across page breaks */
section {
    & > article {
        break-inside: avoid;
        page-break-inside: avoid;
    }
}

/* Page 2: education and certificates after experience */
.cv-secondary {
    break-before: page;
    page-break-before: always;

    & > section:first-child > h2 {
        margin-top: 0;
    }

    @media screen {
        /* Show the page-2 boundary without forcing a blank gap. */
        break-before: auto;
        page-break-before: auto;
        margin-top: 1.25em;
        padding-top: 1em;
        border-top: 0.5pt solid #bbb;
    }

    @media print {
        border-top: none;
        margin-top: 0;
        padding-top: 0;
    }
}

main {
    width: var(--page-width);
    min-height: var(--page-height);
    height: auto;
    padding: var(--page-margin);
    overflow: visible;
    background: #fff;

    & > footer {
        display: none;
    }

    @media screen {
        margin: 0 auto;
        box-shadow: 0 0 0 1px #bbb;
    }

    @media print {
        width: auto;
        min-height: 0;
        margin: 0;
        padding: 0;
        box-shadow: none;
    }
}

.cv-language-switcher {
    @media screen {
        position: fixed;
        top: 1.5rem;
        right: 1.5rem;
        z-index: 1;

        & a {
            display: grid;
            width: 2.5rem;
            height: 2.5rem;
            place-items: center;
            border-radius: 50%;
            font-size: 1.6rem;
            line-height: 1;
            text-decoration: none;

            &:hover,
            &:focus-visible {
                background: #bdbdbd;
                outline: none;
            }
        }
    }

    @media print {
        display: none;
    }
}

html {
    @media print {
        margin: 0;
        padding: 0;
        background: none;
    }
}
