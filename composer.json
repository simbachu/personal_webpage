{
    "name": "simbachu/personal-webpage",
    "description": "Personal webpage for Jennifer Gott",
    "type": "project",
    "license": "proprietary",
    "require": {
        "twig/twig": "^3.21",
        "symfony/yaml": "^7.2",
        "league/commonmark": "^2.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "test:coverage": "phpunit --coverage-text --coverage-html=build/coverage/html --coverage-crap4j=build/coverage/crap4j.xml --coverage-clover=build/coverage/clover.xml"
    }
}
